# Copy this file to .env and fill in real values, then keep .env private.
# .env is gitignored — never commit your tunnel token.

# --- Cloudflare tunnel -------------------------------------------------------
# Token from the Cloudflare Zero Trust dashboard:
#   Networks > Tunnels > Create a tunnel > Cloudflared > copy the token.
# cloudflared reads TUNNEL_TOKEN natively, so this one variable works for both
# the compose stack and the standalone connector container.
TUNNEL_TOKEN=eyJ...replace-with-your-cloudflare-tunnel-token...

# --- Runtime assets ----------------------------------------------------------
# Host directory that holds the runtime assets (models/, kb/, out_neighbors/)
# the app container bind-mounts. "." means this repo folder; on TrueNAS point it
# at the ZFS dataset, e.g. /mnt/pool/apps/svm-xai.
ASSETS_DIR=.
